# Server-only credentials. Never expose this key through NEXT_PUBLIC variables.
SCAN_8004_API_KEY=
SCAN_8004_API_BASE_URL=https://api.8004scan.io/api/v1

# Server-only BSC Testnet reference provider.
# Use a fresh Testnet-only key. Never use a Mainnet-funded wallet.
GRABIT_TESTNET_PROVIDER_PRIVATE_KEY=

# Server-only Altana agent wallet.
# ADMIN grants and revokes the session; it is also the agent's smart-account
# address, so it is the address that needs tBNB.
# SESSION is the scoped key the agent signs its work with. Keep the two
# distinct: the session key is bounded on-chain to the ERC-8183 call allowlist
# and to 0.10 $U per day, so it is the only one that ever touches a job.
# Both must be fresh Testnet-only keys.
GRABIT_ALTANA_ADMIN_PRIVATE_KEY=
GRABIT_ALTANA_SESSION_PRIVATE_KEY=

# Planned integration values
NEXT_PUBLIC_BSC_CHAIN_ID=97
NEXT_PUBLIC_NETWORK_LABEL=BSC Testnet
NEXT_PUBLIC_SITE_URL=http://localhost:3000
